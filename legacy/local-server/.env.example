# Copy this file to .env and fill in what you need.

# Port the server listens on
PORT=3000

# Optional — only needed if you want the Discover tab's AI-suggested events to work.
# Get a key at https://console.anthropic.com. Leave blank to disable that one feature;
# everything else in the app works without it.
ANTHROPIC_API_KEY=

# Optional — which Claude model the Discover tab uses
ANTHROPIC_MODEL=claude-sonnet-4-6

# When Compass is reachable over HTTPS (e.g. behind a reverse proxy):
# COOKIE_SECURE=1 makes the sign-in cookie HTTPS-only; PUBLIC_URL is used in invite / reset links.
COOKIE_SECURE=
PUBLIC_URL=
